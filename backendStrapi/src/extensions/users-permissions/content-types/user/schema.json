{
	"kind": "collectionType",
	"collectionName": "up_users",
	"info": {
		"name": "user",
		"description": "",
		"singularName": "user",
		"pluralName": "users",
		"displayName": "User"
	},
	"options": {
		"draftAndPublish": false,
		"timestamps": true
	},
	"attributes": {
		"username": {
			"type": "string",
			"minLength": 3,
			"required": true,
			"unique": true
		},
		"email": {
			"type": "email",
			"minLength": 6,
			"required": true,
			"unique": true
		},
		"provider": {
			"type": "string"
		},
		"password": {
			"type": "password",
			"minLength": 6,
			"private": true
		},
		"resetPasswordToken": {
			"type": "string",
			"private": true
		},
		"confirmationToken": {
			"type": "string",
			"private": true
		},
		"confirmed": {
			"type": "boolean",
			"default": false
		},
		"blocked": {
			"type": "boolean",
			"default": false
		},
		"role": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.role",
			"inversedBy": "users"
		},
		"firstName": {
			"type": "string"
		},
		"lastName": {
			"type": "string"
		},
		"phone": {
			"type": "string"
		}
	}
}

