{
	"kind": "collectionType",
	"collectionName": "addresses",
	"info": {
		"singularName": "address",
		"pluralName": "addresses",
		"displayName": "Address"
	},
	"options": {
		"comment": "User addresses"
	},
	"attributes": {
		"user": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user",
			"required": true
		},
		"type": {
			"type": "enumeration",
			"enum": ["shipping", "billing"],
			"default": "shipping",
			"required": true
		},
		"fullName": {
			"type": "string",
			"required": true
		},
		"phone": {
			"type": "string",
			"required": true
		},
		"address": {
			"type": "string",
			"required": true
		},
		"city": {
			"type": "string",
			"required": true
		},
		"region": {
			"type": "string"
		},
		"postalCode": {
			"type": "string"
		},
		"isDefault": {
			"type": "boolean",
			"default": false
		},
		"createdAt": {
			"type": "datetime"
		},
		"updatedAt": {
			"type": "datetime"
		}
	}
}
