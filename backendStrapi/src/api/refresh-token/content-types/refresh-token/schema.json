{
	"kind": "collectionType",
	"collectionName": "refresh_tokens",
	"info": {
		"singularName": "refresh-token",
		"pluralName": "refresh-tokens",
		"displayName": "Refresh Token"
	},
	"options": {
		"draftAndPublish": false,
		"comment": "Refresh tokens for user authentication"
	},
	"attributes": {
		"token": {
			"type": "string",
			"required": true,
			"unique": true
		},
		"user": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user",
			"required": true
		},
		"expiresAt": {
			"type": "datetime",
			"required": true
		},
		"revoked": {
			"type": "boolean",
			"default": false
		},
		"createdAt": {
			"type": "datetime"
		},
		"updatedAt": {
			"type": "datetime"
		}
	}
}

