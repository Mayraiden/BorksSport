{
	"kind": "collectionType",
	"collectionName": "orders",
	"info": {
		"singularName": "order",
		"pluralName": "orders",
		"displayName": "Order"
	},
	"options": {
		"comment": "User orders"
	},
	"attributes": {
		"user": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user",
			"required": true
		},
		"orderNumber": {
			"type": "string",
			"required": true,
			"unique": true
		},
		"status": {
			"type": "enumeration",
			"enum": [
				"pending",
				"awaiting_payment",
				"paid",
				"payment_failed",
				"shipped",
				"delivered",
				"cancelled"
			],
			"default": "pending",
			"required": true
		},
		"totalAmount": {
			"type": "decimal",
			"required": true,
			"min": 0
		},
		"items": {
			"type": "json",
			"required": true
		},
		"shippingAddress": {
			"type": "json",
			"required": true
		},
		"paymentMethod": {
			"type": "string"
		},
		"paymentProvider": {
			"type": "string"
		},
		"trackingNumber": {
			"type": "string"
		},
		"notes": {
			"type": "text"
		},
		"customerData": {
			"type": "json"
		},
		"deliveryType": {
			"type": "enumeration",
			"enum": ["door", "pvz", "pickup"],
			"default": "door"
		},
		"cdekOrderUuid": {
			"type": "string",
			"unique": true
		},
		"cdekTariffCode": {
			"type": "integer"
		},
		"cdekDeliveryCost": {
			"type": "decimal"
		},
		"cdekDeliveryDate": {
			"type": "date"
		},
		"cdekDeliveryTimeMin": {
			"type": "string"
		},
		"cdekDeliveryTimeMax": {
			"type": "string"
		},
		"cdekPvzCode": {
			"type": "string"
		},
		"cdekPvzAddress": {
			"type": "text"
		},
		"cdekStatus": {
			"type": "string"
		},
		"cdekTrackNumber": {
			"type": "string"
		},
		"reservedUntil": {
			"type": "datetime"
		},
		"cancelReason": {
			"type": "text"
		},
		"cancelledAt": {
			"type": "datetime"
		},
		"createdAt": {
			"type": "datetime"
		},
		"updatedAt": {
			"type": "datetime"
		}
	}
}
